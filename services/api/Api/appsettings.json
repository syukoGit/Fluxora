{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/fluxora",
    "Realm": "fluxora",
    "Audience": "fluxora-api",
    "AuthClientId": "fluxora-api",
    "AuthClientSecret": "",
    "RequireHttpsMetadata": false,
    "MetadataAddress": "http://localhost:8080/realms/fluxora/.well-known/openid-configuration",
    "UserManagerClientId": "fluxora-user-manager",
    "UserManagerClientSecret": ""
  },
  "Jwt": {
    "SecretKey": "",
    "ValidIssuer": "http://localhost:8080/realms/fluxora",
    "ValidAudience": "fluxora-api",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "TokenExpirationInHours": 1,
    "RefreshTokenExpirationInDays": 7
  }
}